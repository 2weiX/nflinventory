│ +        body = r.read().decode()
│ +    if not expect_reply:
│ +        return None
│ +    # streamable HTTP may answer as SSE lines
│ +    if body.lstrip().startswith("event:") or "\ndata:" in body or body.lstrip().startswith("data:"):
