The core evidence is at app/import/page.tsx:124-130:

```ts
for (const r of good.filter((r) => r.sale)) {
  const { data: c, error } = await supabase.from("cards").insert({...}).select("id
").single();
  if (error) { setBusy(false); return setErr(error.message); }
  const s = await supabase.from("sales").insert({...});
  if (!s.error) sales++;   // <-- sale error ignored, only counted
}
```

