#!/usr/bin/env python3
"""Regenerate discussion/index.md from claim frontmatter. Never hand-edit the index."""
import datetime
import os
import re

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CLAIMS = os.path.join(ROOT, "discussion", "claims")
ORDER = {"open": 0, "researched": 1, "challenged": 2, "adjudicated": 3, "settled": 4, "unfillable": 5}
MARK = {"upheld": "upheld", "weakened": "weakened", "refuted": "REFUTED", "open": "-"}


def frontmatter(path):
    try:
        text = open(path, encoding="utf-8").read()
    except OSError:
        return {}
    m = re.match(r"\s*---\n(.*?)\n---", text, re.S)
    if not m:
        return {}
    out = {}
    for line in m.group(1).splitlines():
        if ":" in line and not line.startswith((" ", "-", "#")):
            k, _, v = line.partition(":")
            out[k.strip()] = v.strip().strip('"\'')
    return out


rows = []
for name in sorted(os.listdir(CLAIMS)) if os.path.isdir(CLAIMS) else []:
    d = os.path.join(CLAIMS, name)
    if not os.path.isdir(d):
        continue
    fm = frontmatter(os.path.join(d, "claim.md"))
    nr = max(len([f for f in os.listdir(d) if re.match(r"r\d+-", f)]),
             int(fm.get("round", 0) or 0))
    rows.append((ORDER.get(fm.get("status", "open"), 9), fm.get("id", name), name, fm, nr))
rows.sort()

out = ["# Claim index", "",
       f"Generated by `bin/reindex` on {datetime.date.today().isoformat()}. **Do not hand-edit.**", "",
       "`settled` claims are not re-litigated unless their falsifier is met. `unfillable` means the evidence",
       "does not exist in public sources - that is a result, not a to-do.", "",
       "| Claim | Status | Verdict | Conf. | Rounds |", "|---|---|---|---|---|"]
for _, cid, name, fm, nr in rows:
    title = fm.get("title", name)
    out.append(f"| [{cid} {title}](claims/{name}/claim.md) | {fm.get('status','open')} "
               f"| {MARK.get(fm.get('verdict',''), fm.get('verdict','-'))} "
               f"| {fm.get('confidence','-')} | {nr} |")
counts = {}
for _, _, _, fm, _ in rows:
    counts[fm.get("status", "open")] = counts.get(fm.get("status", "open"), 0) + 1
out += ["", "## Where the argument stands", ""]
for k in ORDER:
    if counts.get(k):
        out.append(f"- **{counts[k]}** {k}")
decisions = os.path.join(ROOT, "discussion", "decisions")
ds = sorted(f for f in os.listdir(decisions) if f.endswith(".md")) if os.path.isdir(decisions) else []
if ds:
    out += ["", "## Decisions", ""]
    for f in ds:
        fm = frontmatter(os.path.join(decisions, f))
        out.append(f"- [{fm.get('id', f)} {fm.get('title', f)}](decisions/{f}) — {fm.get('status', '')}")
open(os.path.join(ROOT, "discussion", "index.md"), "w", encoding="utf-8").write("\n".join(out) + "\n")
print(f"reindexed {len(rows)} claims, {len(ds)} decisions")
