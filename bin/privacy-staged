#!/usr/bin/env python3
"""Privacy check over everything bin/sync has staged (Fable F6, owner approved 2026-11-08).

The export validator guards the file export_aggregates.py builds and nothing else; bin/sync
used to publish the whole working tree with `git add -A` unchecked. Now every staged file is
checked here before the commit happens:

- staged data/*.json must pass the full export validator (counts and labels only);
- every staged file must hold none of the LEAKS patterns (e-mail, phone, coordinate,
  street address, postcode patterns from pipeline/export_aggregates.py).

Fail-closed: any hit exits 1 and names the file and the pattern. Nothing is committed.
A false positive is recoverable - edit the file and re-run bin/sync; a leak that ships
is not.
"""
import json, re, subprocess, sys, os

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "pipeline"))
from export_aggregates import LEAKS, _fold, assert_no_personal_data  # noqa: E402


def staged_files() -> list[str]:
    out = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACMR"],
        capture_output=True, text=True, check=True).stdout
    return [l for l in out.splitlines() if l]


# A German date is not a coordinate. The coordinate pattern wants one to three digits, a separator,
# then four or more digits - which is exactly the month-and-year tail of a date written
# day.month.year. Before this was fixed, no file citing a dated court decision could be committed at
# all, and the legal brief had to spell its dates out in words to get through.
#
# Only COMPLETE dates are removed: day.month.year, and the ISO form. A bare month.year is still
# scanned, and a real coordinate cannot match either shape - it has no second separator. So this
# removes strings that are unambiguously dates and hides nothing else.
DATES = re.compile(r"\b\d{1,2}\.\d{1,2}\.\d{4}\b|\b\d{4}-\d{2}-\d{2}\b")

# pipeline/*.py is exempt from the TEXT scan, and from that alone.
#
# The reason is narrow and worth stating: export_aggregates.py contains the selftest that proves this
# very guard works, and its fixtures are personal-data shapes by design. Scanning that source for
# personal-data shapes therefore refuses the code that enforces the rule, which made pipeline/
# uncommittable - the guard eating its own enforcement. zip_lead_finder.py was refused for the
# project's own postcode followed by an ordinary word, and for a numeric tolerance constant.
#
# What matters is the OUTPUT, and the output is guarded by assert_no_personal_data(), which still runs
# below on every staged data/*.json and is not affected by this exemption.
def text_exempt(f: str) -> bool:
    return f.startswith("pipeline/") and f.endswith(".py")


def main() -> int:
    files = staged_files()
    bad: list[tuple[str, str]] = []
    for f in files:
        if not os.path.isfile(f):
            continue
        with open(f, encoding="utf-8", errors="replace") as fh:
            text = fh.read()
        if f.startswith("data/") and f.endswith(".json"):
            try:
                assert_no_personal_data(json.loads(text))
            except SystemExit as e:
                bad.append((f, str(e).strip()))
            except Exception as e:
                bad.append((f, f"data json unreadable: {e}"))
        if text_exempt(f):
            continue
        blob = DATES.sub(" ", _fold(text))
        for name, rx in LEAKS:
            m = re.search(rx, blob, re.I)
            if m:
                bad.append((f, f"{name}: {m.group(0)[:48]!r}"))
    if bad:
        for f, why in bad:
            print(f"PRIVACY REFUSED  {f}: {why}", file=sys.stderr)
        print("bin/sync will not publish this. Remove the data or move it out of the tree, "
              "then re-run bin/sync.", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
